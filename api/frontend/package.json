{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "pre-commit": "pnpm deps && pnpm type-check && pnpm lint && pnpm format",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "deps": "pnpm i && pnpm audit -P && pnpm declutter",
    "format": "prettier --write .",
    "type-check": "vue-tsc --declaration --emitDeclarationOnly",
    "declutter": "knip --no-exit-code",
    "test": "vitest --dom --reporter verbose",
    "test:once": "vitest --run --coverage --dom",
    "coverage": "vitest --coverage --dom",
    "test-ui": "vitest --ui",
    "openapi": "openapi-generator-cli --openapitools .openapitools.json generate"
  },
  "pnpm": {
    "overrides": {
      "axios": "1.18.0",
      "ip-address": "10.1.1",
      "basic-ftp": "5.3.1",
      "shell-quote": "1.8.4",
      "esbuild": "0.28.1",
      "js-yaml": "4.2.0",
      "form-data": "4.0.6"
    },
    "auditConfig": {
      "ignoreGhsas": []
    }
  },
  "dependencies": {
    "@lucide/lab": "0.7.0",
    "@tailwindcss/vite": "4.3.3",
    "@vueuse/core": "15.0.0",
    "chart.js": "4.5.1",
    "daisyui": "5.7.42",
    "lucide-vue-next": "1.0.0",
    "marked": "18.0.13",
    "sweetalert2": "11.26.25",
    "tailwindcss": "4.3.3",
    "uuid": "14.0.2",
    "vue": "3.5.43",
    "vue-chartjs": "5.3.4",
    "vue-router": "5.3.1"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "2.41.0",
    "@tsconfig/node22": "22.0.6",
    "@types/node": "26.6.2",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vitest/coverage-v8": "5.0.1",
    "@vitest/eslint-plugin": "1.6.27",
    "@vitest/ui": "5.0.1",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-standard-with-typescript": "9.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "autoprefixer": "10.6.1",
    "eslint": "10.11.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-vue": "10.11.0",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "knip": "6.37.0",
    "msw": "2.15.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  }
}
